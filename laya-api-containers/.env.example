# 開発環境では chat を一緒に起動する。本番ではこの行を消す
COMPOSE_PROFILES=dev

# --- 実行デバイス ---
# 既定は NVIDIA GPU（ホストに NVIDIA ドライバ 580 以上と NVIDIA Container Toolkit が要る）。
# CPU で動かすときは次の2行のコメントを外す（切り替えた後は docker compose up -d --build）。
# COMPOSE_PATH_SEPARATOR=:
# COMPOSE_FILE=docker-compose.yml:docker-compose.cpu.yml

# 本API と呼び出し側サービスが共有する署名用の秘密鍵（32文字以上）。通信には一切載らない
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
API_AUTH_SECRET=

# 署名時刻の許容幅（ミリ秒）。前後どちらにもこの幅まで許す
# AUTH_MAX_SKEW_MS=1000
# UPSTREAM_TIMEOUT_MS=60000
# LOG_LEVEL=info

# --- Laya ---
# 起動時に読み込むチェックポイント（english, multilingual, typed-decisions）
# LAYA_MODELS=english,multilingual
# 言語を判定できない入力に使うチェックポイント
# LAYA_DEFAULT_MODEL=multilingual
# 使う GPU の番号
# LAYA_GPU_ID=0
# CPU 推論のスレッド数（物理コア数以下にする）
# LAYA_THREADS=4
# 重みの取得元を固定する Hub のリビジョン。reviewed は laya 同梱の検証済み SHA
# LAYA_REVISION=reviewed
# NVIDIA ドライバが 580 未満のホストでは次の2行で CUDA 12.8 版の torch にする
# LAYA_TORCH_INDEX=cu128
# LAYA_TORCH_VERSION=2.11.0

# --- ホスト公開（22300-22399 の範囲内に限る） ---
# 別ホストのサービスから呼ぶときだけ API_HOST_BIND=0.0.0.0 にする
# API_HOST_BIND=127.0.0.1
# API_HOST_PORT=22300
# CHAT_HOST_PORT=22301

# --- 誹謗中傷判定の比較用モデル（docs/decisions.md D-10・D-11） ---
# profile を指定したときだけ起動する（例: docker compose --profile eval-h2o up -d）。ホスト公開は 127.0.0.1 のみ
# EVAL_H2O_HOST_PORT=22310
# EVAL_BASAL_HOST_PORT=22311
# EVAL_CHON_HOST_PORT=22312
# EVAL_TOXICITY_HOST_PORT=22313
# Basal の GGUF の量子化。GPU に載らないときは Q6_K
# EVAL_BASAL_QUANT=Q8_0
# Chon の版と量子化。12B の FP8 が GPU に載らないときは次の2行で E2B（bf16）にする
# EVAL_CHON_MODEL=ninhnv/chon-1.0-e2b@5ef9c07c77bfb7637637f1882743703ea139ee8e
# EVAL_CHON_QUANTIZE=
